<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Unpostpone — Activity theme (dark, Android 12+ SplashScreen).
        Same intent as values-night/themes.xml, with the Android 12+ splash
        background pinned to the dark brand surface so the cold-start flash
        does not briefly show a default white frame.
    -->
    <style name="Theme.Unpostpone" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand_teal</item>
        <item name="android:colorPrimaryDark">@color/brand_teal_dark</item>
        <item name="android:colorAccent">@color/brand_teal_soft</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowSplashScreenBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>