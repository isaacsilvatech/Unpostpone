<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Unpostpone — Activity theme (light).
        The Compose ColorScheme in ui/theme/Color.kt owns the in-app surface
        tokens; this XML theme only feeds the system surfaces that read
        ?attr/* before Compose draws (status bar tint, splash background,
        recent-apps card, system dialogs). The values MUST stay in sync with
        Color.kt.
    -->
    <style name="Theme.Unpostpone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_teal</item>
        <item name="android:colorPrimaryDark">@color/brand_teal_dark</item>
        <item name="android:colorAccent">@color/brand_teal_soft</item>
        <item name="android:colorBackground">@color/brand_teal</item>
        <item name="android:windowBackground">@color/brand_teal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    <style name="Theme.Unpostpone.Overtime" parent="Theme.Unpostpone">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>