<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Unpostpone — Brand Color Resources (light)
        Anchored to a single teal primary with two tonal variants (light/dark).
        These colors are used by the Android system (status bar, notifications,
        task switcher, launcher background). The Compose ColorScheme lives in
        ui/theme/Color.kt — keep these two in sync.
    -->
    <color name="brand_teal">#0C4D5B</color>
    <color name="brand_teal_soft">#1F6778</color>
    <color name="brand_teal_dark">#083944</color>
    <color name="brand_cream">#F7F4EA</color>
    <color name="brand_action">#F4A261</color>
    <color name="brand_action_dark">#8C4F1F</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent">#00000000</color>
</resources>